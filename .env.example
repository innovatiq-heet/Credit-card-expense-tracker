# Copy this file to .env.local and fill in the values from
# Supabase Dashboard → Project Settings → API (or "Connect").
# Both values are public (they are shipped to the browser); your data is
# protected by Row Level Security in supabase/schema.sql.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
